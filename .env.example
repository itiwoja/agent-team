# 画面を守る固定トークン（D-06）。32バイト以上のランダム値: openssl rand -base64 32
PHASE0_ACCESS_TOKEN=
# Cookie の署名の鍵。32バイト以上のランダム値
SESSION_COOKIE_SECRET=
# http（localhost）で使うので false。https の前に置くときだけ true
COOKIE_SECURE=false
PORT=8080
# ローカルの sim-world（docker compose）と呼ぶ側（ローカルの app・gateway）で共有するトークン（G-11）。32文字以上: openssl rand -base64 32
SIM_WORLD_SHARED_TOKEN=
# ローカルの app・gateway・sim-world が互いを確かめる共有トークン（G-11）。SIM_WORLD_SHARED_TOKEN と同じ値でよい
INTERNAL_SHARED_TOKEN=
# ローカルの DB（docker compose の db。POSTGRES_PASSWORD を変えたら合わせる）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/open_team
# ローカルのサービスのつなぎ先
SIM_WORLD_URL=http://localhost:8081
GATEWAY_URL=http://localhost:8082
# ゲストの入口のトークン（FR-046。任意）。32バイト以上のランダム値
GUEST_ENTRY_TOKEN=
# Gemini API のキー（Google AI Studio で作る）。無ければ Gemini を呼ぶ機能は使えない
GEMINI_API_KEY=
# LLMプロバイダー（省略時gemini）。設定例と能力・料金の説明は docs/llm-providers.md
# LLM_PROVIDER=gemini | anthropic | openai | deepseek | openrouter | xai | groq | mistral | together | fireworks | cerebras | moonshot | zai | qwen | custom
# 選んだプロバイダーのキーだけを使う（キーの名前の一覧は docs/llm-providers.md）
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# 一覧にない OpenAI 互換 API（custom）。https のみ（localhost は http 可）
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=
# 非GeminiではモデルIDとモデルごとの能力・正の上限料金が必須（値は実際の公式仕様で設定）
# LLM_MODEL_AGENT=YOUR_MODEL_ID
# LLM_MODEL_PLANNER=YOUR_MODEL_ID
# LLM_MODELS_COMPARE=
# 任意：このサーバープロセス全体の試験費用上限（マイクロ米ドル）。再起動でリセット。
# LLM_SESSION_BUDGET_MICRO_USD=1000000
# 任意：試験全体の累計台帳。全プロセスで同じ絶対パスを指定し、削除・初期化しない。
# LLM_TRIAL_LEDGER_PATH=/absolute/path/to/trial-budget.json
# 以下は形式例。モデル名・料金・能力を確認せずそのまま使わない
# LLM_MODELS_JSON={"YOUR_MODEL_ID":{"inputPerMTokMicroUsd":2000000,"outputPerMTokMicroUsd":10000000,"tools":true,"structuredOutput":"tool","temperature":true,"reasoningEffort":false,"maxOutputTokens":8192,"contextWindow":200000}}
# 本人の GitHub（D-119）。使うときだけ入れる（無ければ「GitHub をつなぐ」が出ない）
# アダプター（apps/github。pnpm --filter @open-team/github dev で :8084）
#GITHUB_URL=http://localhost:8084
# gateway とアダプターで共有するトークン（32文字以上）
#GITHUB_SHARED_TOKEN=
# GitHub App（Settings → Developer settings → GitHub Apps）。App ID と秘密鍵は gateway、Client ID・secret・slug は app が使う
#GITHUB_APP_ID=
#GITHUB_APP_PRIVATE_KEY=
#GITHUB_APP_CLIENT_ID=
#GITHUB_APP_CLIENT_SECRET=
#GITHUB_APP_SLUG=
